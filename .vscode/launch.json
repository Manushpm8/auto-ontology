    {
      "name": "Debug API",
      "type": "debugpy",
      "request": "launch",
      "module": "gsf.server",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
