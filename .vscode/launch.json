{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "server.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "3001"
      ],
      "cwd": "${workspaceFolder}/gsf",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/gsf"
      },
      "justMyCode": false
    }
  ]
}
