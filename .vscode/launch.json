{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Create Ontology",
      "type": "debugpy",
      "request": "launch",
      "module": "gsf.ontology.rigor",
      "args": ["--all", "--bird-root", "~/bird/minidev/MINIDEV"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug Local Ingest",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "dev_tools.local_ingest",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Ontology: Rigor+",
      "type": "debugpy",
      "request": "launch",
      "module": "gsf.ontology.rigor",
      "args": ["--all", "--bird-root", "~/bird/minidev/MINIDEV"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug Ingest DuckDB",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "dev_tools.ingest_local_duckdb",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug Ontology",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "gsf.ontology",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug API",
      "type": "debugpy",
      "request": "launch",
      "module": "gsf.server",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Eval Chatbot",
      "type": "debugpy",
      "request": "launch",
      "module": "dev_tools.evaluation.eval_chatbot",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Eval Chatbot (consistency)",
      "type": "debugpy",
      "request": "launch",
      "module": "dev_tools.evaluation.eval_chatbot",
      "args": ["--consistency", "--runs", "10"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Eval Chatbot (single query)",
      "type": "debugpy",
      "request": "launch",
      "module": "dev_tools.evaluation.eval_chatbot",
      "args": ["--single"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Eval BIRD",
      "type": "debugpy",
      "request": "launch",
      "module": "dev_tools.evaluation.eval_chatbot",
      "args": [
        "--input",
        "dev_tools/evaluation/bird_evaluation.json",
        "--output",
        "dev_tools/evaluation/bird_evaluation_scores.csv"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Eval BIRD (single query)",
      "type": "debugpy",
      "request": "launch",
      "module": "dev_tools.evaluation.eval_chatbot",
      "args": [
        "--single",
        "--input",
        "dev_tools/evaluation/bird_evaluation.json"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Ontology: Rigor+ dor_prod",
      "type": "debugpy",
      "request": "launch",
      "module": "gsf.ontology.rigor",
      "args": ["--database-name", "dor_prod"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Ontology: Attributes & Concepts",
      "type": "debugpy",
      "request": "launch",
      "module": "gsf.ontology.attributes_and_concepts",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Re-embed Ontology (dor_prod)",
      "type": "debugpy",
      "request": "launch",
      "module": "dev_tools.reembed_ontology",
      "args": [
        "--database-name",
        "dor_prod"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
