{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Ingest Script Debug",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "dev-tools.ingest_local_postgres",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug API",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "server.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "3001"
            ],
            "cwd": "${workspaceFolder}/gsf",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/gsf"
            },
            "justMyCode": false
        }
    ]
}
