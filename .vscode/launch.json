  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ingest Script Debug",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "dev-tools.ingest_local_postgres",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
