{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Ingest",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "dev_tools.ingest_local_postgres",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug API",
      "type": "debugpy",
      "request": "launch",
      "module": "gsf.server",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Eval Chatbot",
      "type": "debugpy",
      "request": "launch",
      "module": "dev_tools.evaluation.eval_chatbot",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Eval Chatbot (consistency)",
      "type": "debugpy",
      "request": "launch",
      "module": "dev_tools.evaluation.eval_chatbot",
      "args": [
        "--consistency",
        "--runs",
        "10"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Eval Chatbot (single query)",
      "type": "debugpy",
      "request": "launch",
      "module": "dev_tools.evaluation.eval_chatbot",
      "args": [
        "--single"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Semantic: compile dor_prod",
      "type": "debugpy",
      "request": "launch",
      "module": "gsf.semantic",
      "args": [
        "--database-name",
        "dor_prod"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Semantic: compile WWI",
      "type": "debugpy",
      "request": "launch",
      "module": "gsf.semantic",
      "args": [
        "--database-name",
        "WIDEWORLDIMPORTERS"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Eval WWI",
      "type": "debugpy",
      "request": "launch",
      "module": "dev_tools.evaluation.eval_chatbot",
      "args": [
        "--input",
        "dev_tools/evaluation/wwi_evaluation.json",
        "--output",
        "dev_tools/evaluation/wwi_evaluation_scores.csv"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
