# Neo4j connection settings
# bolt://neo4j:7687  — use this when running inside Docker (service name as host)
# bolt://localhost:7687 — use this when running Python scripts on your host machine
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=gsf

# Remote source database that dev-tools/ingest_local_postgres.py reads from
# (schema + rows extracted into the local pgvector store).
# CONNECTION_STRINGS=snowflake://user:password@account?warehouse=COMPUTE_WH&database=WIDEWORLDIMPORTERS
# CONNECTION_STRINGS=postgresql://user:password@host:5432/dbname
CONNECTION_STRINGS=postgresql://user:password@localhost:5432/wideworldimporters

PGADMIN_EMAIL=admin@nvidia.com
PGADMIN_PASSWORD=change-me

# Lighter model for entity extraction
# ENTITY_EXTRACTION_MODEL=aws/anthropic/bedrock-claude-opus-4-8
# ENTITY_EXTRACTION_MODEL=meta/llama-3.1-8b-instruct
# ENTITY_EXTRACTION_MODEL=nvidia/nvidia/Nemotron-3-Nano-30B-A3B

NVIDIA_API_KEY=your-api-key-here
BASE_URL=https://inference-api.nvidia.com/v1
MODEL_NAME=aws/anthropic/bedrock-claude-opus-4-8

# BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b

EMBED_ENDPOINT=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2

# Reranking (used by the rerank flow's rerank_sql_results node).
# RERANK_API_KEY falls back to NVIDIA_API_KEY when unset.
RERANK_ENDPOINT=https://inference-api.nvidia.com/v1/rerank
RERANK_MODEL=nvidia/nvidia/llama-3.2-nv-rerankqa-1b-v2
RERANK_API_KEY=your-api-key-here
RERANK_PRODUCT_HUB_QUERY=product_id

# Non-reasoning model, e.g. for entity extraction. Has its own key/base URL/model
# so it can point at a different endpoint (e.g. inference API) than the main model.
NON_REASONING_NVIDIA_API_KEY=your-api-key-here
NON_REASONING_BASE_URL=https://inference-api.nvidia.com/v1
NON_REASONING_MODEL_NAME=azure/openai/gpt-4.1-mini

APP_URL=http://localhost:3100

# Credentials for the admin user of GSF
GSF_ADMIN_EMAIL=admin@nvidia.com
GSF_ADMIN_PASSWORD=gsfpassword123
AUTH_SECRET=myverylongsecret123

# EMBED_ENDPOINT=https://inference-api.nvidia.com/v1
# EMBED_MODEL=nvidia/nvidia/llama-nemotron-embed-vl-1b-v2
# BASE_URL=https://inference-api.nvidia.com/v1
# MODEL_NAME=nvidia/nvidia/Nemotron-3-Nano-30B-A3B
# MODEL_NAME=openai/openai/gpt-5-nano
# MODEL_NAME=nvidia/nvidia/Nemotron-3-Nano-30B-A3B
# MODEL_NAME=aws/anthropic/bedrock-claude-opus-4-8
