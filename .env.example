# Neo4j connection settings
# bolt://neo4j:7687  — use this when running inside Docker (service name as host)
# bolt://localhost:7687 — use this when running Python scripts on your host machine
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=gsf

# Remote source database that dev-tools/ingest_local_postgres.py reads from
# (schema + rows extracted into the local pgvector store).
# CONNECTION_STRINGS=snowflake://user:password@account?warehouse=COMPUTE_WH&database=WIDEWORLDIMPORTERS
# CONNECTION_STRINGS=postgresql://user:password@host:5432/dbname
CONNECTION_STRINGS=postgresql://user:password@localhost:5432/wideworldimporters

PGADMIN_EMAIL=admin@nvidia.com
PGADMIN_PASSWORD=change-me

# Model-endpoint triplets. Every triplet has three fields:
#   <PREFIX>_ENDPOINT (URL) / <PREFIX>_API_KEY / <PREFIX>_MODEL
# Any field left unset falls back to the matching DEFAULT_MODELS_ value below, so a
# single DEFAULT_MODELS_ triplet can supply the shared endpoint/key/model for all of
# them. Only set the per-triplet fields that need to differ from the default.

# Default triplet — the fallback for every field of every triplet below.
DEFAULT_MODELS_API_KEY=your-api-key-here
DEFAULT_MODELS_ENDPOINT=https://inference-api.nvidia.com/v1
DEFAULT_MODELS_MODEL=aws/anthropic/bedrock-claude-opus-4-8

# Main (reasoning) model.
REASONING_API_KEY=your-api-key-here
REASONING_ENDPOINT=https://inference-api.nvidia.com/v1
REASONING_MODEL=aws/anthropic/bedrock-claude-opus-4-8

# Non-reasoning model, e.g. for entity extraction. Can point at a different
# endpoint than the main model.
NON_REASONING_API_KEY=your-api-key-here
NON_REASONING_ENDPOINT=https://inference-api.nvidia.com/v1
NON_REASONING_MODEL=azure/openai/gpt-4.1-mini

# Embedding triplet. The endpoint + model MUST be identical for ingest and query,
# otherwise stored vectors and query vectors live in different spaces.
EMBED_ENDPOINT=https://inference-api.nvidia.com/v1
EMBED_MODEL=nvidia/nvidia/llama-nemotron-embed-vl-1b-v2
EMBED_API_KEY=your-api-key-here

# Reranking triplet (used by the rerank flow's rerank_sql_results node).
RERANK_ENDPOINT=https://inference-api.nvidia.com/v1/rerank
RERANK_MODEL=nvidia/nvidia/llama-3.2-nv-rerankqa-1b-v2
RERANK_API_KEY=your-api-key-here
RERANK_PRODUCT_HUB_QUERY=product_id

APP_URL=http://localhost:3100

# Credentials for the admin user of GSF
GSF_ADMIN_EMAIL=admin@nvidia.com
GSF_ADMIN_PASSWORD=gsfpassword123
AUTH_SECRET=myverylongsecret123
